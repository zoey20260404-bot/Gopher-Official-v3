# 应用配置
APP_NAME=Gopher Agent
APP_ENV=local
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# 基础设施配置（仅示例，不保存真实凭据）
DATABASE_URL=postgresql+asyncpg://gopher:gopher@localhost:5432/gopher_agent
REDIS_URL=redis://localhost:6379/0

# 认证配置（本地开发请生成至少 32 字符的随机值，禁止提交真实密钥）
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# 模型配置
AGENT_ENABLED=false
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60
AGENT_MAX_ITERATIONS=8
CHECKPOINT_TTL_MINUTES=1440
